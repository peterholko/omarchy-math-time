[Unit]
Description=Math Time multiplication practice
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/peterholko-math-time/runtime.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=peterholko-math-time
RuntimeDirectoryMode=0755
StateDirectory=peterholko-math-time
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/peterholko-math-time /run
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
